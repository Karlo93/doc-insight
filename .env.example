POSTGRES_USER=di
POSTGRES_PASSWORD=di
POSTGRES_DB=di
POSTGRES_PORT=5432
# Set a unique project name and host ports for concurrent checkouts.
COMPOSE_PROJECT_NAME=doc-insight-core
DI_DATABASE_URL=postgresql+psycopg://di_app:di_app@localhost:5432/di
DI_MIGRATION_DATABASE_URL=postgresql+psycopg://di:di@localhost:5432/di
REDIS_PORT=6379
DI_REDIS_URL=redis://127.0.0.1:6379/0
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
DI_S3_ENDPOINT=http://127.0.0.1:9000
DI_S3_REGION=us-east-1
DI_S3_BUCKET=documents
# Public development defaults, never production credentials.
DI_S3_ACCESS_KEY=minioadmin
DI_S3_SECRET_KEY=minioadmin
DI_S3_USE_SSL=false
OTEL_HTTP_PORT=4318
OTEL_HEALTH_PORT=13133
OTEL_PROMETHEUS_PORT=8889
PROMETHEUS_PORT=9090
TEMPO_PORT=3200
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Unset or empty disables telemetry. OTLP/HTTP base URL; signal paths are appended.
# DI_OTEL_ENDPOINT=http://localhost:4318
# Unset uses the name passed to configure(service_name).
# DI_OTEL_SERVICE_NAME=worker
# Bound on each export attempt, including the flush at exit (seconds, default 3).
# DI_OTEL_TIMEOUT_SECONDS=3
DI_ENV=development

# Ingest file limit and tenant-scoped relay batching.
DI_MAX_UPLOAD_BYTES=52428800
DI_RELAY_POLL_SECONDS=1
DI_RELAY_BATCH=100
# di-ingest serve binds loopback by default; containers set DI_HTTP_HOST=0.0.0.0.
# DI_HTTP_HOST=127.0.0.1
# DI_HTTP_PORT=8001

DI_LLM_MODEL=mistral-small-latest
DI_LLM_API_KEY=
DI_LLM_TIMEOUT_SECONDS=10
DI_LLM_BREAKER_FAILURES=3
DI_LLM_BREAKER_SECONDS=30
DI_ABSTAIN_THRESHOLD=0.6
DI_RRF_K=60
DI_QUERY_TOP_K_MAX=20
DI_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
DI_EMBED_ONNX_REPO=Qdrant/paraphrase-multilingual-MiniLM-L12-v2-onnx-Q
DI_EMBED_REVISION=faf4aa4225822f3bc6376869cb1164e8e3feedd0
DI_TOKENIZER_REVISION=e8f8c211226b894fcb81acc59f3b34ba3efd5f42 # gitleaks:allow public model commit
DI_EMBED_BATCH=32
DI_MODEL_CACHE=~/.cache/doc-insight/models
# Opt in once the pinned tokenizer and ONNX snapshots are in DI_MODEL_CACHE;
# the first run has to download them.
# HF_HUB_OFFLINE=1

# Sequential consumer. BLOCK is bounded so an idle worker refreshes its heartbeat.
DI_WORKER_GROUP=worker
DI_WORKER_BLOCK_MS=1000
DI_WORKER_BATCH=1
DI_WORKER_RECLAIM_SECONDS=30
DI_WORKER_CLAIM_MIN_IDLE_MS=300000
DI_WORKER_MAX_ATTEMPTS=5

# Gateway; the development issuer is for local demos only. DI_MAX_UPLOAD_BYTES above is shared.
DI_JWKS_URL=http://127.0.0.1:8000/.well-known/jwks.json
DI_JWT_ISSUER=doc-insight-dev
DI_JWT_AUDIENCE=doc-insight
DI_JWT_LEEWAY_SECONDS=30
DI_JWKS_CACHE_SECONDS=300
DI_JWKS_REFRESH_SECONDS=5
DI_DEV_JWKS_PATH=
DI_REDIS_TIMEOUT_SECONDS=2
DI_RATE_LIMIT_RPS=5
DI_RATE_LIMIT_BURST=10
DI_RATE_LIMIT_FAIL_OPEN=false
DI_MAX_UPSTREAM_RESPONSE_BYTES=16777216
DI_INGEST_URL=http://127.0.0.1:8001
DI_QUERY_URL=http://127.0.0.1:8002
DI_UPSTREAM_TIMEOUT_SECONDS=30
DI_CORS_ORIGINS=
DI_GATEWAY_HOST=127.0.0.1
DI_GATEWAY_PORT=8000
GATEWAY_PORT=8000

# Container URLs use Compose DNS, separately from the host CLI URLs above.
# These public development credentials match init-runtime-role.sql.
DI_CONTAINER_DATABASE_URL=postgresql+psycopg://di_app:di_app@db:5432/di
DI_CONTAINER_MIGRATION_DATABASE_URL=postgresql+psycopg://di:di@db:5432/di
IMAGE_TAG=local
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
# Generate using scripts/dev_keys.py once the gateway service is merged.
DI_DEV_JWKS_FILE=./.cache/dev/jwks.json
# Fixed container wiring (see docs/deploy.md); host URL values above remain for the CLI.
# DI_INGEST_URL=http://ingest:8001
# DI_QUERY_URL=http://query:8002
# DI_JWKS_URL=http://127.0.0.1:8000/.well-known/jwks.json
# DI_DEV_JWKS_PATH=/run/dev/jwks.json
# DI_MODEL_CACHE=/home/di/.cache/doc-insight/models
# HF_HUB_OFFLINE=1
# DI_CONTAINER_APP is selected by the image; DI_CONTAINER_ROLE=relay on relay only.
