POSTGRES_USER=di
POSTGRES_PASSWORD=di
POSTGRES_DB=di
POSTGRES_PORT=5432
# Set a unique project name and host ports for concurrent checkouts.
COMPOSE_PROJECT_NAME=doc-insight-core
DI_DATABASE_URL=postgresql+psycopg://di_app:di_app@localhost:5432/di
DI_MIGRATION_DATABASE_URL=postgresql+psycopg://di:di@localhost:5432/di
REDIS_PORT=6379
DI_REDIS_URL=redis://127.0.0.1:6379/0
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
DI_S3_ENDPOINT=http://127.0.0.1:9000
DI_S3_REGION=us-east-1
DI_S3_BUCKET=documents
# Public development defaults, never production credentials.
DI_S3_ACCESS_KEY=minioadmin
DI_S3_SECRET_KEY=minioadmin
DI_S3_USE_SSL=false
OTEL_HTTP_PORT=4318
OTEL_HEALTH_PORT=13133
OTEL_PROMETHEUS_PORT=8889
PROMETHEUS_PORT=9090
TEMPO_PORT=3200
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Unset or empty disables telemetry. OTLP/HTTP base URL; signal paths are appended.
# DI_OTEL_ENDPOINT=http://localhost:4318
# Unset uses the name passed to configure(service_name).
# DI_OTEL_SERVICE_NAME=worker
# Bound on each export attempt, including the flush at exit (seconds, default 3).
# DI_OTEL_TIMEOUT_SECONDS=3
DI_ENV=development

# Ingest file limit and tenant-scoped relay batching.
DI_MAX_UPLOAD_BYTES=52428800
DI_RELAY_POLL_SECONDS=1
DI_RELAY_BATCH=100
# di-ingest serve binds loopback by default; containers set DI_HTTP_HOST=0.0.0.0.
# DI_HTTP_HOST=127.0.0.1
# DI_HTTP_PORT=8001
