{
  "uid": "doc-insight",
  "title": "Doc Insight",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "doc-insight"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Stage duration · p95",
      "type": "timeseries",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, stage, service) (rate(di_stage_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{service}} / {{stage}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Request latency · p95",
      "type": "timeseries",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, route, status) (rate(di_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{route}} / {{status}}"
        }
      ]
    }
  ]
}
